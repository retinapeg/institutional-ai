flowchart TD
    U["User<br/>mission text"]
    UI["Dashboard<br/>static/index.html"]
    CLI["CLI (cli.py)<br/>demo · serve · inspect"]
    API["FastAPI app (api.py)<br/>/api/projects routes"]
    ENG["InstitutionalEngine<br/>(engine.py)<br/>team → barrier → review<br/>→ revision → Director"]
    GOV["Governance<br/>(governance.py)<br/>jurisdiction · reviewers<br/>role creation · dissent"]
    PROV["FleetDemoProvider<br/>(providers.py)<br/>canned outputs, no model"]
    LIVE["Real model adapter<br/>planned, not in this release"]
    STORE["ProjectStore (store.py)<br/>state.json · events.jsonl<br/>workspaces · org memory"]
    TEST["pytest suite<br/>engine + API tests"]

    U -->|mission form| UI
    U -->|mission| CLI
    UI -->|HTTP JSON| API
    CLI -->|serve| API
    CLI -->|demo| ENG
    CLI -->|inspect| STORE
    API -->|"create · run<br/>· recover"| ENG
    API -->|load snapshot| STORE
    ENG -->|authority checks| GOV
    ENG <-->|"WorkRequest /<br/>ProviderResult"| PROV
    ENG -->|"state, events,<br/>artifacts, memory"| STORE
    PROV -.-|same Provider protocol| LIVE
    TEST -.->|exercise| ENG

    class U human;
    class CLI,UI,API,ENG,GOV det;
    class PROV,LIVE mock;
    class STORE store;
    class TEST eval;

